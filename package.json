{
  "name": "growmore global visa",
  "homepage": "https://www.growmoreglobalvisa.com/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-routes": "node Scripts/generateRoutes.cjs",
    "generate-static-pages": "node Scripts/generateStaticPages.cjs",
    "build": "npx shx rm -rf dist && vite build && npm run generate-routes && npm run generate-static-pages && npx react-snap && node Scripts/fixReactSnapUrls.cjs && npm run sitemap",
    "preview": "vite preview",
    "sitemap": "node Scripts/script.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "reactSnap": {
    "source": "dist",
    "inlineCss": false,
    "skipThirdPartyRequests": true,
    "concurrency": 1,
    "delay": 1000,
    "executionTimeLimit": 45000,
    "crawl": false,
    "exclude": [
      "/blogs",
      "/blogs/",
      "/brochures",
      "/brochures/"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--disable-gl-drawing-for-tests"
    ],
    "include":[
  "/",
  "/about-us/",
  "/services/work-visa/",
  "/services/migration-visa/",
  "/services/dependent-visa/",
  "/services/visitor-visa/",
  "/services/student-visa/",
  "/latest-update/videos/",
  "/latest-update/news/",
  "/latest-update/blogs/",
  "/english-test/",
  "/english-test/ielts/",
  "/english-test/pte/",
  "/english-test/toefl/",
  "/english-test/duolingo/",
  "/english-test/cambridge-c1-advanced/",
  "/english-test/languagecert-academic/",
  "/contact-us/",
  "/brochures/",
  "/migration-assessment/points-calculator-australia/",
  "/services/student-visa/australia/",
  "/services/student-visa/dubai/",
  "/services/student-visa/france/",
  "/services/student-visa/germany/",
  "/services/student-visa/singapore/",
  "/services/student-visa/georgia/",
  "/services/student-visa/russia/",
  "/services/student-visa/new-zealand/",
  "/services/student-visa/canada/",
  "/services/student-visa/usa/",
  "/services/student-visa/united-kingdom/",
  "/services/student-visa/europe/",
  "/migration-assessment/points-calculator-canada/",
  "/terms-services/",
  "/privacy-policy/",
  "/cancellation-and-refund-policy/",
  "/aritificial-intelligence-use-policy/"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-calendly": "^4.4.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.2.6",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^3.0.0",
    "react-icon": "^1.0.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.16.0",
    "react-toastify": "^11.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sitemap": "^9.0.1",
    "swiper": "^12.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.15",
    "puppeteer": "^25.5.0",
    "react-snap": "1.23.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.12",
    "vite-node": "^6.0.0"
  }
}
